# Local PostgreSQL or a Supabase session pooler URL used by scripts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# At least 32 random characters. Required by the deployed Worker to sign
# anonymous game-completion proofs. Never expose this as a NEXT_PUBLIC variable.
GAME_TOKEN_SECRET="replace-with-at-least-32-random-characters"

# Used only by the playlist worker to upload clips and catalog state.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="balkanguess-audio"

# Set only in the GitHub Actions worker.
# CATALOG_STORAGE="r2"

# The deployed Cloudflare Worker receives DATABASE_URL as a Worker secret and
# reads audio through its private AUDIO_BUCKET R2 binding. It needs no R2 keys.
