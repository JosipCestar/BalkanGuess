# Cloudflare Worker secret: use the Supabase transaction pooler URL.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres
GAME_TOKEN_SECRET=replace-with-at-least-32-random-characters

# GitHub Actions secret SUPABASE_DATABASE_URL should use the Supabase session
# pooler URL on port 5432 so Prisma migrations and the worker can run.
# GitHub also needs R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, and
# R2_BUCKET_NAME. Its R2 token needs Object Read & Write for balkanguess-audio.
