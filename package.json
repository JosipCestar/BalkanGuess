{
  "name": "balkan-guess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "dev:playlist": "tsx scripts/dev-playlist.ts",
    "playlist": "tsx scripts/playlist.ts",
    "dev:cloudflare": "vinext dev --port 3001",
    "build:cloudflare": "vinext build",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare:first": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/first-cloudflare-deploy.ps1",
    "deploy:cloudflare": "npm run build:cloudflare && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@eslint/js": "9.35.0",
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.3",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "type": "module"
}
