generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Song {
  id                Int         @id @default(autoincrement())
  title             String
  artist            String
  normalizedTitle   String
  normalizedArtist  String
  releaseYear       Int?
  country           String?
  genre             String?
  soundcloudTrackId String?
  soundcloudUrl     String?
  sourceUrl         String?     @unique
  clipKey           String?
  categories        String[]    @default([])
  previewStart      Float       @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  dailySongs        DailySong[]

  @@index([active])
}

model DailySong {
  id       Int    @id @default(autoincrement())
  date     String
  category String @default("legacy")
  songId   Int
  song     Song   @relation(fields: [songId], references: [id], onDelete: Restrict)

  @@unique([date, category])
}

model DailyResult {
  id         Int      @id @default(autoincrement())
  date       String
  category   String   @default("legacy")
  playerHash String
  won        Boolean
  attempt    Int
  createdAt  DateTime @default(now())

  @@unique([date, category, playerHash])
}

model DailyAggregate {
  id       Int     @id @default(autoincrement())
  date     String
  category String
  won      Boolean
  attempt  Int
  count    Int     @default(0)

  @@unique([date, category, won, attempt])
}
